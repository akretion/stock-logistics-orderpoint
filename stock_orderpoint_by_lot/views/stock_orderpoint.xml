<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_warehouse_orderpoint_tree_editable_lot_triger" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.editable</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <button name="action_replenish" position="after">
                <button
                    name="action_replenish"
                    string="Order lot"
                    type="object"
                    class="o_replenish_buttons"
                    icon="fa-truck"
                    invisible="not replenish_by_lot"
                />
            </button>
        </field>
    </record>
</odoo>
