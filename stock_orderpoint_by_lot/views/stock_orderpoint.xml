<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- stock.warehouse.orderpoint inherit tree view -->
    <record id="stock_warehouse_orderpoint" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.inherit.view.tree</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <field name="qty_forecast" position="after">
                <field name="lot_id" />
            </field>
        </field>
    </record>
</odoo>
